{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/services", "destination": "/services.html" },
    { "source": "/services/", "destination": "/services.html" },
    { "source": "/wordpress-plugin-development", "destination": "/wordpress-plugin-development.html" },
    { "source": "/wordpress-plugin-development/", "destination": "/wordpress-plugin-development.html" },
    { "source": "/woocommerce-custom-development", "destination": "/woocommerce-custom-development.html" },
    { "source": "/woocommerce-custom-development/", "destination": "/woocommerce-custom-development.html" },
    { "source": "/learndash-customization-services", "destination": "/learndash-customization-services.html" },
    { "source": "/learndash-customization-services/", "destination": "/learndash-customization-services.html" },
    { "source": "/api-integrations-services", "destination": "/api-integrations-services.html" },
    { "source": "/api-integrations-services/", "destination": "/api-integrations-services.html" },
    { "source": "/maintenance", "destination": "/maintenance.html" },
    { "source": "/maintenance/", "destination": "/maintenance.html" },
    { "source": "/hire-a-full-stack-wordpress-developer", "destination": "/hire-a-full-stack-wordpress-developer.html" },
    { "source": "/hire-a-full-stack-wordpress-developer/", "destination": "/hire-a-full-stack-wordpress-developer.html" },
    { "source": "/portfolio", "destination": "/portfolio.html" },
    { "source": "/portfolio/", "destination": "/portfolio.html" },
    { "source": "/about-us", "destination": "/about-us.html" },
    { "source": "/about-us/", "destination": "/about-us.html" },
    { "source": "/about", "destination": "/about-us.html" },
    { "source": "/contact-us", "destination": "/contact-us.html" },
    { "source": "/contact-us/", "destination": "/contact-us.html" },
    { "source": "/contact", "destination": "/contact-us.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/privacy-policy/", "destination": "/privacy-policy.html" },
    { "source": "/imprint", "destination": "/imprint.html" },
    { "source": "/imprint/", "destination": "/imprint.html" },
    { "source": "/terms-and-conditions", "destination": "/terms-and-conditions.html" },
    { "source": "/terms-and-conditions/", "destination": "/terms-and-conditions.html" },
    { "source": "/pricing", "destination": "/maintenance.html" },
    { "source": "/pricing/", "destination": "/maintenance.html" },
    { "source": "/blog", "destination": "/portfolio.html" },
    { "source": "/blog/", "destination": "/portfolio.html" }
  ]
}
